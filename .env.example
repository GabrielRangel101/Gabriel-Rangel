# Copie para .env.local em desenvolvimento. Em produção, defina na Vercel (Settings > Environment Variables).

# URL pública final do site (domínio próprio). Se vazio, usa a URL de produção da Vercel.
NEXT_PUBLIC_SITE_URL=

# Deixe vazio até o lançamento: o site fica fora dos buscadores. Use "true" ao publicar de vez.
NEXT_PUBLIC_INDEXABLE=
